<Project>
  <!-- Generated from eng/jellyfin-profiles.json. Run eng/generate-jellyfin-props.ps1 to update. -->

  <PropertyGroup>
    <PluginBaseVersion Condition="'$(PluginBaseVersion)' == ''">3.10.0</PluginBaseVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(JellyfinBuildProfile)' == '' And '$(JellyfinProfile)' == '10.11.11'">
    <JellyfinBuildProfile>10.11.11</JellyfinBuildProfile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(JellyfinBuildProfile)' == '' And '$(JellyfinProfile)' == '12.0'">
    <JellyfinBuildProfile>12.0</JellyfinBuildProfile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(JellyfinBuildProfile)' == '' And '$(JellyfinProfile)' == '12.1'">
    <JellyfinBuildProfile>12.0</JellyfinBuildProfile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(JellyfinBuildProfile)' == '10.11.11'">
    <JellyfinPackageVersion>10.11.11</JellyfinPackageVersion>
    <JellyfinTargetAbi>10.11.11.0</JellyfinTargetAbi>
    <JellyfinTargetFramework>net9.0</JellyfinTargetFramework>
    <PluginVersion>$(PluginBaseVersion).101111</PluginVersion>
    <JellyfinCompatibilityConstants>JELLYFIN_10_11;JELLYFIN_USER_IN_DATABASE_ENTITIES</JellyfinCompatibilityConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(JellyfinBuildProfile)' == '12.0'">
    <JellyfinPackageVersion>12.0.0</JellyfinPackageVersion>
    <JellyfinTargetAbi>12.0.0.0</JellyfinTargetAbi>
    <JellyfinTargetFramework>net10.0</JellyfinTargetFramework>
    <PluginVersion>$(PluginBaseVersion).120000</PluginVersion>
    <JellyfinCompatibilityConstants>JELLYFIN_12;JELLYFIN_USER_IN_DATABASE_ENTITIES</JellyfinCompatibilityConstants>
  </PropertyGroup>
</Project>
